<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.enhmusical.ui.ClientFormController"
      spacing="12">
    <padding>
        <Insets top="10" right="30" bottom="20" left="30"/>
    </padding>

    <GridPane hgap="10" vgap="10">
        <Label text="Nome dos noivos *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="couplesNameField" prefWidth="360"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Telefone *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="12999999999"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Data do evento *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateEventPicker"
                    GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Horário *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="timeEventField" promptText="HH:mm (ex.: 17:30)"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Local do evento *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="localEventField"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Salvar" onAction="#onSave" defaultButton="true"/>
        <Button text="Novo" onAction="#onNew"/>
        <Button text="Excluir" onAction="#onDelete"/>
    </HBox>

    <Label fx:id="messageLabel" wrapText="true"/>

    <TableView fx:id="clientTable" prefHeight="260" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="coupleColumn" text="Noivos"/>
            <TableColumn fx:id="phoneColumn" text="Telefone"/>
            <TableColumn fx:id="dateColumn" text="Data"/>
            <TableColumn fx:id="timeColumn" text="Horário"/>
            <TableColumn fx:id="localColumn" text="Local"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>